class ListingWriter {
  init(filepath) {
    this.filepath = filepath;
  }

  padRight(str, targetLen) {
    while (str.length() < targetLen) {
      str = str + " ";
    }
    return str;
  }

  padLeft(str, targetLen, padChar) {
    while (str.length() < targetLen) {
      str = padChar + str;
    }
    return str;
  }

  save(entries, symbolTable) {
    var lines = [];
    lines.push("; ==================================================================");
    lines.push("; 6502 ASSEMBLY LISTING");
    lines.push("; ==================================================================");
    lines.push("LINE  ADDR   HEX BYTES      SOURCE");
    lines.push("------------------------------------------------------------------");

    for (var i = 0; i < entries.length(); i += 1) {
      var entry = entries[i];
      var lineNum = this.padLeft("" + (entry["line"] ?? i + 1), 4, "0");

      // Handle directives or labels that do not emit machine bytes
      if (entry["bytes"] == nil or entry["bytes"].length() == 0) {
        var addrText = (entry["address"] != nil) 
          ? "$" + Math.hex(entry["address"], 4, false) 
          : "    ";
        lines.push(lineNum + "  " + addrText + "   " + this.padRight("", 14) + entry["source"]);
        continue;
      }

      var addrHex = "$" + Math.hex(entry["address"], 4, false);
      
      // Format opcode + operand bytes (e.g. "8D 20 D0 ")
      var bytesHex = "";
      var bytes = entry["bytes"];
      for (var b = 0; b < bytes.length(); b += 1) {
        bytesHex = bytesHex + Math.hex(bytes[b], 2, false) + " ";
      }

      lines.push(lineNum + "  " + addrHex + "  " + this.padRight(bytesHex, 14) + entry["source"]);
    }

    // Append Symbol Cross-Reference Table
    if (symbolTable != nil) {
      lines.push("");
      lines.push("; ==================================================================");
      lines.push("; SYMBOL TABLE");
      lines.push("; ==================================================================");
      var keys = symbolTable.keys();
      for (var k = 0; k < keys.length(); k += 1) {
        var name = keys[k];
        var addr = Math.hex(symbolTable[name], 4, false);
        lines.push(this.padRight(name, 24) + " = $" + addr);
      }
    }

    var content = lines.join("\n");
    return File.save(this.filepath, content);
  }
}
