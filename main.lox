fun getOpcode(mnemonic, mode, operandValue) {
  if (!OPCODES.has(mnemonic)) {
    print "Error: Unknown mnemonic " + mnemonic;
    return nil;
  }

  var modes = OPCODES[mnemonic];

  if (mode == AddressingMode.ABSOLUTE and operandValue and operandValue <= 255) {
    if (modes.has(AddressingMode.ZERO_PAGE)) {
      return modes[AddressingMode.ZERO_PAGE];
    }
  }

  if (mode == AddressingMode.ABSOLUTE_X and operandValue and operandValue <= 255) {
    if (modes.has(AddressingMode.ZERO_PAGE_X)) {
      return modes[AddressingMode.ZERO_PAGE_X];
    }
  }

  if (modes.has(mode))
    return modes[mode];

  print "Error: Illegal addressing mode " + mode + " for " + mnemonic;
  return nil;
}

fun emitInstruction(stmt, currentPC, symbolTable, outputBuffer) {
  var value = evalExpr(stmt.operant, symbolTable);
  var op = getOpcode(stmt.name, stmt.mode, value);

  if (op == nil) return;

  // 1. emit opcode byte
  outputBuffer.add(op.code);

  // 2. emit operands based on actual size
  if (op.bytes == 2) {
    if (stmt.mode == AddressingMode.RELATIVE) {
      // calculate 8-bit signed branch offset
      var offset = value - (currentPC + 2);
      if (offset < -128 or offset > 127) {
        print "Error: Branch out of range";
      }
      outputBuffer.add(offset & 0xff);
    } else {
      // 8-bit immediate or zero page
      outputBuffer.add(value & 0xff);
    }
  } else if (op.bytes == 3) {
    // 16-bit absolute address (little-endian: low byte, high byte)
    outputBuffer.add(value & 0xff);
    outputBuffer.add((value >> 8) & 0xff);
  }
}

