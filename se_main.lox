import "ffi";
require("notcurses.lox");
require("sprite_editor.lox");

var nc = Notcurses();
at_exit(fun() { nc.stop(); });

nc.enable_mouse();

var editor = SpriteEditor(nc, 16, 16);

if (editor.valid) {
  editor.loop();
  editor.stop();
  print "Sprite editor closed.";
}

