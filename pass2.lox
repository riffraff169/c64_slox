require("expr.lox");
require("textconv.lox");

class Pass2 {
  init(statements, symbolTable, opcodes, startAddress = 0x0801, diagnostics = nil) {
    this.statements = statements;
    this.symbolTable = symbolTable;
    this.opcodes = opcodes;
    this.currentAddress = startAddress;
    this.bytes = [];
    this.diagnostics = diagnostics;
  }

  report(line, message) {
    if (this.diagnostics != nil) {
      this.diagnostics.error(line, message);
      return;
    }

    print "Error on line " + line + ": " + message;
  }

  run(sourceLines) {
    var listingEntries = [];

    for (var i = 0; i < this.statements.length(); i += 1) {
      var stmt = this.statements[i];

      // 1. capture address before assembling this statement
      var addrBefore = this.currentAddress;
      var lenBefore = this.bytes.length();

      // 2. assemble statement
      if (stmt.type == "INSTRUCTION") {
        this.assembleInstruction(stmt);
      } else if (stmt.type == "DIRECTIVE") {
        this.assembleDirective(stmt);
      }

      // "ORIGIN" and "LABEL_ONLY" emit no output bytes directly

      // 3. extract emitted bytes
      var emittedBytes = [];
      for (var b = lenBefore; b < this.bytes.length(); b += 1) {
        emittedBytes.push(this.bytes[b]);
      }

      // 4. advance pass 2's current address counter
      this.currentAddress += emittedBytes.length();

      var sourceText = "";
      if (sourceLines and stmt.line <= sourceLines.length()) {
        sourceText = sourceLines[stmt.line - 1];
      } else {
        sourceText = stmt.name ?? "";
      }

      // 5. get source line text
      listingEntries.push({
          "line": stmt.line,
          "address": stmt.pc,
          "bytes": emittedBytes,
          "source": sourceText
          });
    }

    return {
      "bytes": this.bytes,
      "listingEntries": listingEntries
    };
  }

  assembleInstruction(stmt) {
    var mnemonic = stmt.name;
    var mode = stmt.mode;

    // 1. look up opcode byte
    if (!this.opcodes.has(mnemonic) or !this.opcodes[mnemonic].has(mode)) {
      this.report(stmt.line, "Invalid instruction or mode (" + mnemonic + " " + mode + ")");
      return;
    }

    var opcodeObj = this.opcodes[mnemonic][mode];
    this.emitByte(opcodeObj.code);

    // implied & accumulator modes emit no operand bytes
    if (mode == AddressingMode.IMPLIED or mode == AddressingMode.ACCUMULATOR) {
      return;
    }

    // 2. resolve operand value
    var val = this.resolveOperand(stmt.operand, stmt.pc, stmt.line);
    if (val == nil) return;

    if (mode == AddressingMode.ZERO_PAGE or
        mode == AddressingMode.ZERO_PAGE_X or
        mode == AddressingMode.ZERO_PAGE_Y or
        mode == AddressingMode.IND_X or
        mode == AddressingMode.IND_Y) {
      if (val < 0 or val > 255) {
        this.report(stmt.line, "Zero-page operand out of range (" + val + ")");
        return;
      }
    }

    // 3. emit operand bytes base on mode
    if (mode == AddressingMode.RELATIVE) {
      // relative branch offset calculation: target_address - (current_pc + 2)
      var offset = val - (stmt.pc + 2);

      if (offset < -128 or offset > 127) {
        this.report(stmt.line, "Branch out of range (" + offset + " bytes)");
        return;
      }

      // convert negative offset to 8-bit two's complement
      if (offset < 0) {
        offset += 256;
      }

      this.emitByte(offset);
    } else if (mode == AddressingMode.IMMEDIATE or
        mode == AddressingMode.ZERO_PAGE or
        mode == AddressingMode.ZERO_PAGE_X or
        mode == AddressingMode.ZERO_PAGE_Y or
        mode == AddressingMode.IND_X or
        mode == AddressingMode.IND_Y) {
      this.emitByte(val);
    } else if (mode == AddressingMode.ABSOLUTE or
        mode == AddressingMode.ABSOLUTE_X or
        mode == AddressingMode.ABSOLUTE_Y or
        mode == AddressingMode.INDIRECT) {
      // 16-bit address (little-endian: low byte, high byte)
      this.emitWord(val);
    }
  }

  assembleDirective(stmt) {
    var name = stmt.name.to_upper();
    var currentPC = stmt.pc ?? 0;

    if (name == ".BYTE" or name == ".BASIC") {
      if (typeof(stmt.operand) == "Array") {
        for (var i = 0; i < stmt.operand.length(); i += 1) {
          var val = this.resolveOperand(stmt.operand[i], currentPC, stmt.line);
          if (val != nil) this.emitByte(val);
        }
      } else {
        var val = this.resolveOperand(stmt.operand, currentPC, stmt.line);
        if (val != nil) this.emitByte(val);
      }
    } else if (name == ".WORD") {
      if (typeof(stmt.operand) == "Array") {
        for (var i = 0; i < stmt.operand.length(); i += 1) {
          var val = this.resolveOperand(stmt.operand[i], currentPC, stmt.line);
          if (val != nil) this.emitWord(val);
        }
      } else {
        var val = this.resolveOperand(stmt.operand, currentPC, stmt.line);
        if (val != nil) this.emitWord(val);
      }
    } else if (name == ".TEXT" or name == ".STRING") {
      var str = stmt.operand;
      for (var i = 0; i < str.length(); i += 1) {
        this.emitByte(str[i]);
      }
    } else if (name == ".PET") {
      var petBytes = TextConv.petBytes(stmt.operand);
      for (var i = 0; i < petBytes.length(); i += 1) {
        this.emitByte(petBytes[i]);
      }
    } else if (name == ".SCREEN") {
      var screenBytes = TextConv.screenBytes(stmt.operand);
      for (var i = 0; i < screenBytes.length(); i += 1) {
        this.emitByte(screenBytes[i]);
      }
    } else if (name == ".ASSERT") {
      var ok = this.resolveOperand(stmt.operand, currentPC, stmt.line);
      if (ok == nil) return;

      if (ok == 0) {
        var message = stmt.message ?? "assertion failed";
        if (message == "") message = "assertion failed";
        this.report(stmt.line, "Assertion failed: " + message + " (" + stmt.operand + ")");
      }
    } else if (name == ".ALIGN") {
      var boundaryCheck = this.resolveOperand(stmt.operand, currentPC, stmt.line);
      if (boundaryCheck == nil) return;

      for (var i = 0; i < stmt.size; i += 1) {
        this.emitByte(0x00);
      }
    } else if (name == ".FILL" or name == ".RES") {
      var countCheck = this.resolveOperand(stmt.operand, currentPC, stmt.line);
      if (countCheck == nil) return;

      var fillVal = 0x00;
      if (stmt.fillValExpr and stmt.fillValExpr != "") {
        fillVal = this.resolveOperand(stmt.fillValExpr, currentPC, stmt.line) ?? 0x00;
      }
      for (var i = 0; i < stmt.size; i += 1) {
        this.emitByte(fillVal & 0xff);
      }
    } else if (name == ".INCBIN" or name == ".INCLUDEBIN") {
      if (stmt.binaryData) {
        for (var i = 0; i < stmt.binaryData.length(); i += 1) {
          this.emitByte(stmt.binaryData[i]);
        }
      }
    }
  }

  resolveOperand(op, pc, line) {
    if (op == nil) return nil;
    if (isnumber(op)) return op;

    var exprStr = op;

    // strip immediate '#' prefix if still present
    if (isstring(exprStr) and exprStr.length() > 0 and exprStr[0] == '#') {
      exprStr = exprStr.slice(1);
    }

    var evaluator = ExpressionEvaluator();
    return evaluator.evaluate(exprStr, this.symbolTable, pc, true, this.diagnostics, line);
  }

  resolveTerm(term, lineNum) {
    if (term == "") return 0;

    // 1. plain integer
    if (isnumber(term)) return term;

    // 2. hex
    if (term[0] == '$') {
      return Math.from_hex("0x" + term.slice(1));
    }
    if (term.length() >= 2 and term.slice(0, 2) == "0x") {
      return Math.from_hex(term);
    }

    // 3. symbol table lookup
    if (this.symbolTable.has(term)) {
      return this.symbolTable[term];
    }

    this.report(lineNum, "Undefined symbol '" + term + "'");
    return nil;
  }

  emitByte(b) {
    this.bytes.push(b % 256);
  }

  emitWord(w) {
    var lowByte = w % 256;
    var highByte = (w / 256).floor() % 256;
    this.bytes.push(lowByte);
    this.bytes.push(highByte);
  }
}
