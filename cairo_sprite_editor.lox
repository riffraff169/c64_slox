require("canvas.lox");

// X11 + Cairo sprite editor. Kept alongside the notcurses editor so both
// front-ends share the same 24x21 sprite data semantics.
//
// Mono mode stores one bit per cell. Multicolor mode stores a 2-bit pattern in
// each horizontal pair of cells, matching the C64 sprite memory layout.
class CairoSpriteEditor {
  init(canvas, options = nil) {
    this.canvas = canvas;
    this.grid_width = 24;
    this.grid_height = 21;

    this.mono_palette = [
      [25, 25, 35],
      [255, 255, 255]
    ];
    this.mc_palette = [
      [25, 25, 35],
      [240, 240, 240],
      [20, 60, 60],
      [80, 120, 200]
    ];
    this.mono_labels = ["0: Off / Transparent", "1: On / White"];
    this.mc_labels = ["00: Transparent", "01: Shared 1", "10: Primary", "11: Shared 2"];

    this.is_multicolor = false;
    this.active_pattern = 0;
    this.status = "Ready";

    this.pixels = [];
    for (var y = 0; y < this.grid_height; y += 1) {
      this.pixels.push([0; this.grid_width]);
    }

    this.dialog_mode = nil;
    this.dialog_text = "";
    this.pressed_button = nil;

    this.compute_layout();
    this.build_buttons();
  }

  compute_layout() {
    var available_width = this.canvas.width - 360;
    var available_height = this.canvas.height - 190;
    var cell_width = available_width / this.grid_width;
    var cell_height = available_height / this.grid_height;

    this.cell_size = cell_width < cell_height ? cell_width : cell_height;
    if (this.cell_size < 8) this.cell_size = 8;

    this.canvas_x = 24;
    this.canvas_y = 130;
    this.panel_x = this.canvas_x + (this.grid_width * this.cell_size) + 28;
    this.panel_width = this.canvas.width - this.panel_x - 24;
    if (this.panel_width < 180) this.panel_width = 180;

    this.palette_y = this.canvas_y;
    this.preview_y = this.palette_y + 190;
    var preview_width = (this.panel_width - 32) / this.grid_width;
    this.preview_cell = preview_width < 12 ? preview_width : 12;
  }

  build_buttons() {
    this.buttons = [
      {"label": "Mode (M)", "x": 24, "y": 72, "width": 130, "height": 38},
      {"label": "Save (S)", "x": 164, "y": 72, "width": 120, "height": 38},
      {"label": "Load (L)", "x": 294, "y": 72, "width": 120, "height": 38},
      {"label": "Clear (C)", "x": 424, "y": 72, "width": 130, "height": 38},
      {"label": "Quit (Q)", "x": 564, "y": 72, "width": 120, "height": 38}
    ];
  }

  set_status(message) {
    this.status = message;
  }

  current_palette() {
    return this.is_multicolor ? this.mc_palette : this.mono_palette;
  }

  current_labels() {
    return this.is_multicolor ? this.mc_labels : this.mono_labels;
  }

  pattern_count() {
    return this.is_multicolor ? 4 : 2;
  }

  select_pattern(index) {
    if (index < 0 or index >= this.pattern_count()) return false;
    this.active_pattern = index;
    this.set_status("Selected pattern " + this.current_labels()[index]);
    return true;
  }

  toggle_mode() {
    this.is_multicolor = !this.is_multicolor;
    if (!this.is_multicolor and this.active_pattern > 1) {
      this.active_pattern = 1;
    }
    var name = this.is_multicolor ? "multicolor" : "single-color";
    this.set_status("Switched to " + name + " mode");
  }

  clear_pixels() {
    for (var y = 0; y < this.grid_height; y += 1) {
      for (var x = 0; x < this.grid_width; x += 1) {
        this.pixels[y][x] = 0;
      }
    }
    this.set_status("Cleared sprite");
  }

  set_pixel(x, y) {
    if (x < 0 or x >= this.grid_width or y < 0 or y >= this.grid_height) return false;

    if (!this.is_multicolor) {
      this.pixels[y][x] = this.active_pattern != 0 ? 1 : 0;
    } else {
      var pair_x = x - (x % 2);
      var pattern = this.active_pattern & 3;
      this.pixels[y][pair_x] = pattern;
      this.pixels[y][pair_x + 1] = pattern;
    }
    return true;
  }

  get_pixel(x, y) {
    if (x < 0 or x >= this.grid_width or y < 0 or y >= this.grid_height) return nil;
    return this.pixels[y][x];
  }

  pack_sprite() {
    var bytes = [];
    for (var y = 0; y < this.grid_height; y += 1) {
      for (var byte_col = 0; byte_col < 3; byte_col += 1) {
        var value = 0;
        if (!this.is_multicolor) {
          for (var bit = 0; bit < 8; bit += 1) {
            var x = (byte_col * 8) + bit;
            if (this.pixels[y][x] != 0) value = value | (1 << (7 - bit));
          }
        } else {
          for (var pair = 0; pair < 4; pair += 1) {
            var x = (byte_col * 8) + (pair * 2);
            var pattern = this.pixels[y][x] & 3;
            value = value | (pattern << (6 - (pair * 2)));
          }
        }
        bytes.push(chr(value));
      }
    }
    bytes.push(chr(0));
    return bytes.join("");
  }

  unpack_sprite(data) {
    if (data == nil or data.length() < 63) return false;

    var byte_index = 0;
    for (var y = 0; y < this.grid_height; y += 1) {
      for (var byte_col = 0; byte_col < 3; byte_col += 1) {
        var value = data[byte_index];
        byte_index = byte_index + 1;

        if (!this.is_multicolor) {
          for (var bit = 0; bit < 8; bit += 1) {
            var x = (byte_col * 8) + bit;
            this.pixels[y][x] = (value & (1 << (7 - bit))) != 0 ? 1 : 0;
          }
        } else {
          for (var pair = 0; pair < 4; pair += 1) {
            var x = (byte_col * 8) + (pair * 2);
            var pattern = (value >> (6 - (pair * 2))) & 3;
            this.pixels[y][x] = pattern;
            this.pixels[y][x + 1] = pattern;
          }
        }
      }
    }
    return true;
  }

  save_sprite(filepath) {
    if (filepath == nil or filepath == "") {
      this.set_status("Save cancelled: empty filename");
      return false;
    }

    var saved = File.save(filepath, this.pack_sprite()) != nil;
    if (saved) this.set_status("Saved 64-byte sprite to " + filepath);
    else this.set_status("Error: could not write " + filepath);
    return saved;
  }

  load_sprite(filepath) {
    if (filepath == nil or filepath == "") {
      this.set_status("Load cancelled: empty filename");
      return false;
    }

    var data = File.load(filepath);
    if (!this.unpack_sprite(data)) {
      this.set_status("Error: invalid or unreadable sprite file " + filepath);
      return false;
    }

    this.set_status("Loaded sprite from " + filepath);
    return true;
  }

  canvas_cell_at(px, py) {
    if (px < this.canvas_x or py < this.canvas_y) return nil;
    var gx = Integer((px - this.canvas_x) / this.cell_size);
    var gy = Integer((py - this.canvas_y) / this.cell_size);
    if (gx < 0 or gx >= this.grid_width or gy < 0 or gy >= this.grid_height) return nil;
    return [gx, gy];
  }

  palette_index_at(px, py) {
    var count = this.pattern_count();
    var x0 = this.panel_x + 16;
    var y0 = this.palette_y + 46;
    if (px < x0 or py < y0) return nil;
    var index = Integer((py - y0) / 40);
    if (index < 0 or index >= count) return nil;
    if (px > x0 + this.panel_width - 32) return nil;
    return index;
  }

  button_at(px, py) {
    for (var i = 0; i < this.buttons.length(); i += 1) {
      var button = this.buttons[i];
      if (px >= button["x"] and px <= button["x"] + button["width"] and
          py >= button["y"] and py <= button["y"] + button["height"]) {
        return button["label"];
      }
    }
    return nil;
  }

  open_dialog(mode) {
    this.dialog_mode = mode;
    this.dialog_text = "";
    var verb = mode == "save" ? "Save" : "Load";
    this.set_status(verb + " sprite: type a filename, Enter to confirm, Esc to cancel");
  }

  close_dialog() {
    this.dialog_mode = nil;
    this.dialog_text = "";
  }

  handle_dialog_key(event) {
    var keysym = event["keysym"];
    if (keysym == X11.XK_Return or keysym == X11.XK_KP_Enter) {
      var filepath = this.dialog_text;
      var mode = this.dialog_mode;
      this.close_dialog();
      if (mode == "save") this.save_sprite(filepath);
      else this.load_sprite(filepath);
      return;
    }

    if (keysym == X11.XK_Escape) {
      this.close_dialog();
      this.set_status("Cancelled");
      return;
    }

    if (keysym == X11.XK_BackSpace) {
      if (this.dialog_text.length() > 0) {
        this.dialog_text = this.dialog_text.slice(0, this.dialog_text.length() - 1);
      }
      return;
    }

    var text = event["text"];
    if (text == nil or text.length() != 1) return;
    this.dialog_text = this.dialog_text + text;
  }

  activate_button(label) {
    if (label == "Mode (M)") {
      this.toggle_mode();
    } else if (label == "Save (S)") {
      this.open_dialog("save");
    } else if (label == "Load (L)") {
      this.open_dialog("load");
    } else if (label == "Clear (C)") {
      this.clear_pixels();
    } else if (label == "Quit (Q)") {
      this.canvas.running = false;
    }
  }

  handle_key(event) {
    var keysym = event["keysym"];
    if (this.dialog_mode != nil) {
      this.handle_dialog_key(event);
      return;
    }

    if (keysym == X11.XK_Escape) {
      this.canvas.running = false;
      return;
    }

    var key = event["text"];
    if (key == nil or key.length() != 1) return;

    if (key == "q" or key == "Q") {
      this.canvas.running = false;
    } else if (key == "m" or key == "M") {
      this.toggle_mode();
    } else if (key == "s" or key == "S") {
      this.open_dialog("save");
    } else if (key == "l" or key == "L") {
      this.open_dialog("load");
    } else if (key == "c" or key == "C") {
      this.clear_pixels();
    } else if (key == "1") {
      this.select_pattern(0);
    } else if (key == "2") {
      this.select_pattern(1);
    } else if (key == "3") {
      this.select_pattern(2);
    } else if (key == "4") {
      this.select_pattern(3);
    }
  }

  handle_event(event) {
    var type = event["type"];
    if (type == X11.KeyPress) {
      this.handle_key(event);
      return;
    }

    if (this.dialog_mode != nil) return;
    if (event["button"] != 1) return;

    var px = event["x"];
    var py = event["y"];

    if (type == X11.ButtonPress) {
      this.pressed_button = this.button_at(px, py);
      return;
    }

    if (type != X11.ButtonRelease) return;

    var released = this.button_at(px, py);
    if (released != nil and released == this.pressed_button) {
      this.pressed_button = nil;
      this.activate_button(released);
      return;
    }
    this.pressed_button = nil;

    var palette_index = this.palette_index_at(px, py);
    if (palette_index != nil) {
      this.select_pattern(palette_index);
      return;
    }

    var cell = this.canvas_cell_at(px, py);
    if (cell != nil) {
      this.set_pixel(cell[0], cell[1]);
    }
  }

  draw(canvas) {
    canvas.clear([0.055, 0.060, 0.085]);
    canvas.textTop(24, 18, "Slox Sprite Editor (Cairo)", [0.92, 0.95, 1.0], 20.0);

    var mode_name = this.is_multicolor ? "MULTICOLOR (24x21, 2-bit pairs)" :
      "SINGLE-COLOR (24x21, 1-bit)";
    canvas.textTop(24, 48, mode_name, [0.55, 0.65, 0.78], 12.0);

    this.draw_buttons(canvas);
    this.draw_canvas(canvas);
    this.draw_palette(canvas);
    this.draw_preview(canvas);

    canvas.line(20, canvas.height - 40, canvas.width - 20, canvas.height - 40,
        [0.20, 0.23, 0.31], 1.0);
    canvas.textTop(24, canvas.height - 32, this.status, [0.72, 0.78, 0.88], 12.0);

    if (this.dialog_mode != nil) this.draw_dialog(canvas);
  }

  draw_button(canvas, button) {
    var background = [0.13, 0.15, 0.21];
    if (this.pressed_button == button["label"]) {
      background = [0.08, 0.48, 0.66];
    }

    canvas.fillRect(button["x"], button["y"], button["width"], button["height"], background);
    canvas.strokeRect(button["x"], button["y"], button["width"], button["height"],
        [0.30, 0.34, 0.44], 1.0);
    canvas.textMiddle(button["x"], button["y"], button["width"], button["height"],
        button["label"], [0.92, 0.94, 0.98], 13.0);
  }

  draw_buttons(canvas) {
    for (var i = 0; i < this.buttons.length(); i += 1) {
      this.draw_button(canvas, this.buttons[i]);
    }
  }

  draw_canvas(canvas) {
    var size = this.cell_size;
    canvas.fillRect(this.canvas_x - 6, this.canvas_y - 6,
        (this.grid_width * size) + 12, (this.grid_height * size) + 12,
        [0.08, 0.09, 0.13]);
    canvas.strokeRect(this.canvas_x - 6, this.canvas_y - 6,
        (this.grid_width * size) + 12, (this.grid_height * size) + 12,
        [0.30, 0.34, 0.44], 1.0);

    var palette = this.current_palette();
    for (var y = 0; y < this.grid_height; y += 1) {
      for (var x = 0; x < this.grid_width; x += 1) {
        var value = this.pixels[y][x];
        var color = palette[0];
        if (this.is_multicolor) color = palette[value & 3];
        else if (value != 0) color = palette[1];

        var px = this.canvas_x + (x * size);
        var py = this.canvas_y + (y * size);
        canvas.fillRect(px, py, size, size, color);
        canvas.strokeRect(px, py, size, size, [0.18, 0.20, 0.27], 0.5);
      }
    }
  }

  draw_palette(canvas) {
    var palette = this.current_palette();
    var labels = this.current_labels();
    canvas.textTop(this.panel_x, this.palette_y, "Pattern", [0.90, 0.93, 0.98], 15.0);

    var x0 = this.panel_x + 16;
    var y0 = this.palette_y + 46;
    var width = this.panel_width - 32;
    for (var i = 0; i < this.pattern_count(); i += 1) {
      var y = y0 + (i * 40);
      var color = palette[i];
      canvas.fillRect(x0, y, 42, 28, color);
      canvas.strokeRect(x0, y, 42, 28, [0.30, 0.34, 0.44], 1.0);

      if (i == this.active_pattern) {
        canvas.strokeRect(x0 - 3, y - 3, width, 34, [0.10, 0.78, 1.0], 2.0);
      }
      canvas.textTop(x0 + 54, y + 7, labels[i], [0.82, 0.86, 0.93], 12.0);
    }
  }

  draw_preview(canvas) {
    var preview_x = this.panel_x + 16;
    var preview_y = this.preview_y + 34;
    var size = this.preview_cell;
    var palette = this.current_palette();

    canvas.textTop(this.panel_x, this.preview_y, "Preview", [0.90, 0.93, 0.98], 15.0);
    canvas.fillRect(preview_x - 4, preview_y - 4,
        (this.grid_width * size) + 8, (this.grid_height * size) + 8,
        [0.04, 0.05, 0.07]);

    for (var y = 0; y < this.grid_height; y += 1) {
      for (var x = 0; x < this.grid_width; x += 1) {
        var value = this.pixels[y][x];
        var color = palette[0];
        if (this.is_multicolor) color = palette[value & 3];
        else if (value != 0) color = palette[1];
        canvas.fillRect(preview_x + (x * size), preview_y + (y * size),
            size, size, color);
      }
    }
  }

  draw_dialog(canvas) {
    var x = 260;
    var y = 250;
    var width = 440;
    var height = 180;
    var verb = this.dialog_mode == "save" ? "Save" : "Load";

    canvas.fillRect(x, y, width, height, [0.08, 0.09, 0.13]);
    canvas.strokeRect(x, y, width, height, [0.30, 0.34, 0.44], 2.0);
    canvas.textTop(x + 20, y + 20, verb + " Sprite", [0.92, 0.95, 1.0], 18.0);
    canvas.textTop(x + 20, y + 54, "Filename:", [0.72, 0.78, 0.88], 12.0);

    canvas.fillRect(x + 20, y + 78, width - 40, 40, [0.04, 0.05, 0.07]);
    canvas.strokeRect(x + 20, y + 78, width - 40, 40, [0.10, 0.78, 1.0], 2.0);
    canvas.textTop(x + 32, y + 91, this.dialog_text, [1.0, 1.0, 1.0], 14.0);
    canvas.textTop(x + 20, y + 140, "Enter: confirm    Esc: cancel", [0.55, 0.60, 0.70], 11.0);
  }

  render() {
    this.canvas.render(fun(c) { this.draw(c); });
    return this;
  }
}
