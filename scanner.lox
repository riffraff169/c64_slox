//require("logger.lox");
require("c64_parser.lox");
require("tokens.lox");

class AssemblyScanner {
  init(source, logger = nil) {
    this.source = source;
    this.logger = logger;
    this.tokens = [];
    this.len = (source == nil) ? 0 : source.length();
    this.start = 0;
    this.current = 0;
    this.line = 1;
  }

  // logging helpers
  logDebug(msg) {
    if (this.logger)
      this.logger.debug(msg);
  }

  logInfo(msg) {
    if (this.logger)
      this.logger.info(msg);
  }

  logWarn(msg) {
    if (this.logger)
      this.logger.warn(msg);
  }

  logError(msg) {
    if (this.logger)
      this.logger.error(msg);
  }

  isAtEnd() {
    return this.current >= this.len;
  }

  advance() {
    var c = this.source[this.current];
    this.current = this.current + 1;
    return c;
  }

  peek() {
    if (this.isAtEnd()) return '\0';
    return this.source[this.current];
  }

  peekNext() {
    if (this.current + 1 >= this.len) return 0;
    return this.source[this.current + 1];
  }

  scanTokens() {
    this.logDebug("Starting scan phase (" + this.len + " characters)...");

    while (!this.isAtEnd()) {
      this.start = this.current;
      this.scanToken();
    }

    this.tokens.push(Token(TokenType.EOF_TOKEN, "", nil, this.line));
    this.logInfo("Scanning completed: " + this.tokens.length() + " tokens scanned.");
    return this.tokens;
  }

  scanToken() {
    var c = this.advance();

    if (c == ' ' or c == '\r' or c == '\t') {
      // ignore whitespace
      return;
    }

    if (c == '\n') {
      this.addToken(TokenType.NEWLINE, nil);
      this.line = this.line + 1;
      return;
    }

    if (c == ';') {
      // comment
      while (this.peek() != '\n' and !this.isAtEnd()) {
        this.advance();
      }
      return;
    }

    if (c == '#') return this.addToken(TokenType.HASH, nil);
    if (c == ',') return this.addToken(TokenType.COMMA, nil);
    if (c == ':') return this.addToken(TokenType.COLON, nil);
    if (c == '(') return this.addToken(TokenType.LPAREN, nil);
    if (c == ')') return this.addToken(TokenType.RPAREN, nil);
    if (c == '=') return this.addToken(TokenType.EQUAL, nil);
    if (c == '*') return this.addToken(TokenType.STAR, nil);
    if (c == '+') return this.addToken(TokenType.PLUS, "+");
    if (c == '-') return this.addToken(TokenType.MINUS, "-");
    if (c == '<') return this.addToken(TokenType.LESS, "-");
    if (c == '>') return this.addToken(TokenType.GREATER, "-");
    if (c == '"') return;

    // directives (.byte, .word, .org)
    if (c == '.') {
      this.directive();
      return;
    }

    // hex numbers ($0801, $ff)
    if (c == '$') {
      this.hexNumber();
      return;
    }

    // binary numbers (%00000001)
    if (c == '%') {
      this.binaryNumber();
      return;
    }

    // decimal
    if (isDigit(c)) {
      this.decimalNumber();
      return;
    }

    // identifiers and mnemonics (LDA, STA, main, loop)
    if (isAlpha(c)) {
      this.identifier();
      return;
    }

    this.logError("Line: " + this.line + ": Unexpected character '" + c + "'");
  }

  // helpers & matchers

  directive() {
    while (isAlphaNumeric(this.peek())) {
      this.advance();
    }
    var text = this.source.slice(this.start, this.current);
    if (text.length() == 1) {
      this.logWarn("Line " + this.line + ": Empty directive '.' encountered.");
    }
    this.addToken(TokenType.DIRECTIVE, text.to_upper());
  }
    
  parseHex(str) {
    var val = 0;
    if (str == nil) return 0;
    if (isnumber(str))
      return str;
    var len = str.length() ?? 0;
    if (len == 0) return 0;
    var start = 0;

    if (str[0] == '$') {
      start = 1;
    } else if (str.length() > 1 and str[0] == '0' and (str[1] == 'x' or str[1] == 'X')) {
      start = 2;
    }
    return Math.from_hex("0x" + str.slice(start));
  }

  parseBinary(str) {
    var val = 0;
    var len = str.length() ?? 0;
    if (len == 0) return 0;
    var start = 0;

    if (str[0] == '%') start = 1;

    for (var i = start; i < str.length(); i += 1) {
      var c = str[i];
      if (c == '0') {
        val = val * 2;
      } else if (c == '1') {
        val = (val * 2) + 1;
      } else {
        break;
      }
    }
    return val;
  }

  decimalNumber() {
    while (isDigit(this.peek()))
      this.advance();

    var str = this.source.slice(this.start + 1, this.current);
    var val = Number(str);
    this.addToken(TokenType.NUMBER, val);
  }

  hexNumber() {
    while (isHexDigit(this.peek())) {
      this.advance();
    }
    var hexStr = this.source.slice(this.start + 1, this.current);
    var val = this.parseHex(hexStr);
    this.addToken(TokenType.NUMBER, val);
  }

  binaryNumber() {
    while (this.peek() == '0' or this.peek() == '1') {
      this.advance();
    }

    var text = this.source.slice(this.start + 1, this.current);
    var val = Math.from_bin(text);
    this.addToken(TokenType.NUMBER, val);
  }

  identifier() {
    while (isAlphaNumeric(this.peek())) {
      this.advance();
    }
    var text = this.source.slice(this.start, this.current);
    this.addToken(TokenType.IDENTIFIER, nil);
  }

  addToken(type, literal) {
    var text = this.source.slice(this.start, this.current);
    var token = Token(type, text, literal, this.line);
    this.tokens.push(token);
    var debugText = (type == TokenType.NEWLINE) ? "\\n" : text;
    this.logDebug("Token added: Token(" + String(type) + ", '" + debugText + "', " + String(literal) + ", line " + String(this.line) + ")");
  }
}

