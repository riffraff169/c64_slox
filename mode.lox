class AddressingMode {
  const IMPLIED = "IMPLIED";
  const ACCUMULATOR = "ACCUMULATOR";
  const IMMEDIATE = "IMMEDIATE"; // #$ff
  const ZERO_PAGE = "ZERO_PAGE";
  const ZERO_PAGE_X = "ZERO_PAGE_X";
  const ZERO_PAGE_Y = "ZERO_PAGE_Y";
  const ABSOLUTE = "ABSOLUTE"; // $0800 or label (pass 2 picks zp vs abs)
  const ABSOLUTE_X = "ABSOLUTE_X"; // $0800,x
  const ABSOLUTE_Y = "ABSOLUTE_Y"; // $0800,y
  const INDIRECT = "INDIRECT"; // ($a000)
  const IND_X = "IND_X"; // ($02,x)
  const IND_Y = "IND_Y"; // ($02),y
  const RELATIVE = "RELATIVE";
}

class Statement {
  init(type, label, name, mode, operand, line) {
    this.type = type;   // "INSTRUCTION", "DIRECTIVE", "ORIGIN"
    this.label = label; // "loop" or nil
    this.name = name;   // "LDA", ".byte", etc
    this.mode = mode;   // AddressingMode constant
    this.operand = operand; // raw expression / value / symbol
    this.line = line;
    //this.fillValExpr = 0;
  }

  to_string() {
    var lbl = this.label ? "[" + this.label + ":] " : "";
    var md = this.mode ? " (" + this.mode + ")" : "";
    var op = this.operand ? " " + this.operand : "";
    return "[" + this.line + "] " + lbl + this.type + " " + this.name + md + op;
  }
}


