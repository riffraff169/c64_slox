require("scanner.lox");
require("c64_parser.lox");
require("opcodes.lox");
require("pass1.lox");

var source = "* = $0801\n" +
             "start:\n" +
             "  LDA #$00\n" +
             "loop:\n" +
             "  STA $d020\n" +
             "  RTS\n";

var tokens = AssemblyScanner(source).scanTokens();
var statements = AssemblyParser(tokens).parse();
var result = Pass1(statements, OPCODES).run();
var symbols = result["symbolTable"];

print Math.hex(result["startAddress"], 4, false); // expect: 0801
print Math.hex(result["endPC"], 4, false); // expect: 0807
print Math.hex(symbols["start"], 4, false); // expect: 0801
print Math.hex(symbols["loop"], 4, false); // expect: 0803

for (var i = 0; i < result["statements"].length(); i += 1) {
  var stmt = result["statements"][i];
  print Math.hex(stmt.pc, 4, false) + ":" + stmt.size + ":" + stmt.type + ":" + stmt.name;
}

// expect: 0801:0:ORIGIN:*=
// expect: 0801:0:LABEL_ONLY:
// expect: 0801:2:INSTRUCTION:LDA
// expect: 0803:0:LABEL_ONLY:
// expect: 0803:3:INSTRUCTION:STA
// expect: 0806:1:INSTRUCTION:RTS
