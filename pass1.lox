require("expr.lox");

class Pass1 {
  init(statements, opcodes, diagnostics = nil) {
    this.statements = statements;
    this.opcodes = opcodes;
    this.diagnostics = diagnostics;
    this.symbolTable = {};
    this.currentPC = 0x0801;
    this.hasOrigin = false;
    this.reportErrors = true;
  }

  report(line, message) {
    if (!this.reportErrors) return;

    if (this.diagnostics != nil) {
      this.diagnostics.error(line, message);
      return;
    }

    print "Error on line " + line + ": " + message;
  }

  run(initialSymbols = nil, reportErrors = true) {
    var evaluator = ExpressionEvaluator();
    this.reportErrors = reportErrors;
    this.symbolTable = {};

    if (initialSymbols != nil) {
      var keys = initialSymbols.keys();
      for (var k = 0; k < keys.length(); k += 1) {
        this.symbolTable[keys[k]] = initialSymbols[keys[k]];
      }
    }

    var definedSymbols = {};
    this.currentPC = 0x0801;
    this.hasOrigin = false;

    for (var i = 0; i < this.statements.length(); i += 1) {
      var stmt = this.statements[i];

      // 1. constant assigment (eg BORDER_COLOR = $d020)
      if (stmt.type == "CONSTANT") {
        var val = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC,
          false, nil, stmt.line);
        this.symbolTable[stmt.label] = val;
        definedSymbols[stmt.label] = true;
        stmt.pc = this.currentPC;
        stmt.size = 0;
        continue;
      }

      // 2. origin directive (* = $0801)
      if (stmt.type == "ORIGIN") {
        if (this.hasOrigin) {
          this.report(stmt.line, "Multiple origin (* =) directives are not supported in single PRG mode.");
          return;
        }
        var val = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC,
          false, nil, stmt.line);
        this.currentPC = val;
        stmt.pc = val;
        stmt.size = 0;
        this.hasOrigin = true;
        continue;
      }

      // 3. address labels
      if (stmt.label and stmt.label != "") {
        if (definedSymbols.has(stmt.label)) {
          this.report(stmt.line, "Duplicate label '" + stmt.label + "'");
        } else {
          definedSymbols[stmt.label] = true;
          this.symbolTable[stmt.label] = this.currentPC;
        }
      }

      // attach current pc to the statement node for pass 2 lookup
      stmt.pc = this.currentPC;

      // 4. calculate byte size and advance the pc
      if (stmt.type == "INSTRUCTION") {
        if (stmt.baseMode == nil) stmt.baseMode = stmt.mode;
        var size = this.calculateInstructionSize(stmt);
        stmt.size = size;
        this.currentPC += size;
      } else if (stmt.type == "DIRECTIVE") {
        var dirName = stmt.name.to_upper();

        if (dirName == ".BASIC") {
          this.currentPC = 2049; // $-8-1
          stmt.pc = this.currentPC;
          stmt.size = 13;
          this.currentPC += 13;
        } else if (dirName == ".ALIGN") {
          var boundary = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC,
            false, nil, stmt.line);
          boundary = this.valid_alignment(stmt, boundary);

          var remainder = this.currentPC % boundary;
          var padding = (remainder == 0) ? 0 : (boundary - remainder);

          stmt.pc = this.currentPC;
          stmt.size = padding;
          this.currentPC += padding;
        } else if (dirName == ".FILL" or dirName == ".RES") {
          var count = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC,
            false, nil, stmt.line);
          if (count < 0) {
            this.report(stmt.line, "." + dirName.slice(1).to_upper() + " count must not be negative");
            count = 0;
          }

          stmt.pc = this.currentPC;
          stmt.size = count;
          this.currentPC += count;
        } else {
          var size = this.calculateDirectiveSize(stmt);
          stmt.size = size;
          this.currentPC += size;
        }
      } else if (stmt.type == "LABEL_ONLY") {
        stmt.size = 0;
      }
    }

    var startPC = 0x0801;
    if (this.statements.length() > 0 and this.statements[0].pc != nil) {
      startPC = this.statements[0].pc;
    }

    return {
      "symbolTable": this.symbolTable,
      "statements": this.statements,
      "startAddress": startPC,
      "startPC": startPC,
      "endPC": this.currentPC
    };
  }

  valid_alignment(stmt, boundary) {
    if (boundary <= 0) {
      this.report(stmt.line, ".ALIGN boundary must be positive");
      return 1;
    }

    var check = boundary;
    while (check > 1) {
      if (check % 2 != 0) {
        this.report(stmt.line, ".ALIGN boundary must be a power of two");
        return 1;
      }
      check = (check / 2).floor();
    }
    return boundary;
  }

  calculateInstructionSize(stmt) {
    var evaluator = ExpressionEvaluator();
    var mode = stmt.baseMode ?? stmt.mode;
    stmt.mode = mode;

    if (mode == AddressingMode.ABSOLUTE or
        mode == AddressingMode.ABSOLUTE_X or
        mode == AddressingMode.ABSOLUTE_Y) {
      var val = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC,
        false, nil, stmt.line);

      if (val >= 0 and val <= 255) {
        if (mode == AddressingMode.ABSOLUTE and
            this.supportsMode(stmt.name, AddressingMode.ZERO_PAGE)) {
          mode = AddressingMode.ZERO_PAGE;
          stmt.mode = mode;
          return 2;
        }
        if (mode == AddressingMode.ABSOLUTE_X and
            this.supportsMode(stmt.name, AddressingMode.ZERO_PAGE_X)) {
          mode = AddressingMode.ZERO_PAGE_X;
          stmt.mode = mode;
          return 2;
        }
        if (mode == AddressingMode.ABSOLUTE_Y and
            this.supportsMode(stmt.name, AddressingMode.ZERO_PAGE_Y)) {
          mode = AddressingMode.ZERO_PAGE_Y;
          stmt.mode = mode;
          return 2;
        }
      }
    }

    if (mode == AddressingMode.IMPLIED or mode == AddressingMode.ACCUMULATOR) {
      return 1;
    }
    if (mode == AddressingMode.IMMEDIATE or
        mode == AddressingMode.ZERO_PAGE or
        mode == AddressingMode.ZERO_PAGE_X or
        mode == AddressingMode.ZERO_PAGE_Y or
        mode == AddressingMode.IND_X or
        mode == AddressingMode.IND_Y or
        mode == AddressingMode.RELATIVE) {
      return 2;
    }
    if (mode == AddressingMode.ABSOLUTE or
        mode == AddressingMode.ABSOLUTE_X or
        mode == AddressingMode.ABSOLUTE_Y or
        mode == AddressingMode.INDIRECT) {
      return 3;
    }
    return 1;
  }

  supportsMode(mnemonic, mode) {
    if (!this.opcodes.has(mnemonic)) return false;
    return this.opcodes[mnemonic].has(mode);
  }

  calculateDirectiveSize(stmt) {
    var evaluator = ExpressionEvaluator();
    var name = stmt.name.to_upper();

    if (name == ".BYTE") {
      if (typeof(stmt.operand) == "Array") return stmt.operand.length();
      return 1;
    }
    if (name == ".WORD") {
      if (typeof(stmt.operand) == "Array") return stmt.operand.length() * 2;
      return 2;
    }
    if (name == ".TEXT" or name == ".STRING" or
        name == ".PET" or name == ".SCREEN") {
      return stmt.operand.length();
    }
    if (name == ".INCBIN" or name == ".INCLUDEBIN") {
      var fileContent = File.load(stmt.operand);
      if (fileContent == nil) {
        this.report(stmt.line, "Cannot open binary file '" + stmt.operand + "'");
        return 0;
      }

      var fileLen = fileContent.length();
      var offset = 0;

      if (stmt.offsetExpr and stmt.offsetExpr != "") {
        offset = evaluator.evaluate(stmt.offsetExpr, this.symbolTable, this.currentPC,
          true, this.diagnostics, stmt.line);
      }

      var count = fileLen - offset;
      if (stmt.lengthExpr and stmt.lengthExpr != "") {
        count = evaluator.evaluate(stmt.lengthExpr, this.symbolTable, this.currentPC,
          true, this.diagnostics, stmt.line);
      }

      if (offset >= fileLen or count <= 0) {
        stmt.binaryData = [];
        return 0;
      }

      // clamp valid read range within file bounds
      var endPos = offset + count;
      if (endPos > fileLen) endPos = fileLen;
      var slicedStr = fileContent.slice(offset, endPos);

      var bytes = slicedStr.split("").map(fun(w) { return w[0]; });

      // pad
      var padCount = count - bytes.length();
      if (padCount > 0) {
        bytes = bytes + [0; padCount];
      }
        
      stmt.binaryData = bytes;
      return bytes.length();
    }

    return 0;
  }
}

fun statement_layout_key(statements) {
  var key = "";
  for (var i = 0; i < statements.length(); i += 1) {
    var stmt = statements[i];
    key = key + (stmt.pc ?? -1) + ":" + (stmt.size ?? -1) + ":" + (stmt.mode ?? "") + "|";
  }
  return key;
}

fun run_pass1_to_fixpoint(statements, opcodes, diagnostics = nil, verbose = false) {
  var maxPasses = 16;
  var previousSymbols = nil;
  var previousLayout = nil;
  var result = nil;
  var converged = false;
  var passCount = maxPasses;

  for (var pass = 0; pass < maxPasses; pass += 1) {
    var pass1 = Pass1(statements, opcodes, diagnostics);
    result = pass1.run(previousSymbols, false);
    previousSymbols = result["symbolTable"];

    var layout = statement_layout_key(statements);
    if (verbose) print "  Pass 1 iteration " + (pass + 1) + ": " + layout;

    if (previousLayout != nil and layout == previousLayout) {
      converged = true;
      passCount = pass + 1;
      break;
    }
    previousLayout = layout;
  }

  if (!converged) {
    var message = "Pass 1 did not converge after " + maxPasses + " iterations";
    if (diagnostics != nil) {
      diagnostics.error(nil, message);
    } else {
      print "Error: " + message;
    }
  }

  var finalPass = Pass1(statements, opcodes, diagnostics);
  result = finalPass.run(previousSymbols, true);
  result["passes"] = passCount;
  return result;
}
