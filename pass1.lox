require("expr.lox");

class Pass1 {
  init(statements, opcodes) {
    this.statements = statements;
    this.opcodes = opcodes;
    this.symbolTable = {};
    this.currentPC = 0x0801;
    this.hasOrigin = false;
  }

  run() {
    var evaluator = ExpressionEvaluator();

    for (var i = 0; i < this.statements.length(); i += 1) {
      var stmt = this.statements[i];

      // 1. constant assigment (eg BORDER_COLOR = $d020)
      if (stmt.type == "CONSTANT") {
        var val = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC);
        this.symbolTable[stmt.label] = val;
        stmt.pc = this.currentPC;
        stmt.size = 0;
        continue;
      }

      // 2. origin directive (* = $0801)
      if (stmt.type == "ORIGIN") {
        if (this.hasOrigin) {
          print "Error on line " + stmt.line + ": Multiple origin (* =) directives are not supported in single PRG mode.";
          return;
        }
        var val = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC);
        this.currenPC = val;
        stmt.pc = this.currentPC;
        stmt.size = 0;
        this.hasOrigin = true;
        continue;
      }

      // 3. address labels
      if (stmt.label and stmt.label != "") {
        if (this.symbolTable.has(stmt.label)) {
          print "Error on line " + stmt.line + ": Duplicate label '" + stmt.label + "'";
        } else {
          this.symbolTable[stmt.label] = this.currentPC;
        }
      }

      // attach current pc to the statement node for pass 2 lookup
      stmt.pc = this.currentPC;

      // 4. calculate byte size and advance the pc
      if (stmt.type == "INSTRUCTION") {
        var size = this.calculateInstructionSize(stmt);
        stmt.size = size;
        this.currentPC += size;
      } else if (stmt.type == "DIRECTIVE") {
        var dirName = stmt.name.to_upper();

        if (dirName == ".BASIC") {
          this.currentPC = 2049; // $-8-1
          stmt.pc = this.currentPC;
          stmt.size = 13;
          this.currentPC += 13;
        } else if (dirName == ".ALIGN") {
          var boundary = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC);
          if (boundary <= 0) boundary = 1;

          var remainder = this.currentPC % boundary;
          var padding = (remainder == 0) ? 0 : (boundary - remainder);

          stmt.pc = this.currentPC;
          stmt.size = padding;
          this.currentPC += padding;
        } else if (dirName == ".FILL") {
          var count = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC);

          stmt.pc = this.currentPC;
          stmt.size = count;
          this.currentPC += count;
        } else {
          var size = this.calculateDirectiveSize(stmt);
          stmt.size = size;
          this.currentPC += size;
        }
      } else if (stmt.type == "LABEL_ONLY") {
        this.symbolTable[stmt.name] = this.currentPC;
        stmt.size = 0;
      }
    }

    var startPC = 0x0801;
    if (this.statements.length() > 0) {
      startPC = this.statements[0].pc;
    }

    return {
      "symbolTable": this.symbolTable,
      "statements": this.statements,
      "startPC": startPC,
      "endPC": this.currentPC
    };
  }

  calculateInstructionSize(stmt) {
    // zero-page early optimization
    // if the operand is a literal number <= 255, downgrade ABSOLUTE -> ZERO_PAGE early
    var val = this.parseOperandValue(stmt.operand);
    /*
    print typeof(stmt.operand);
    print stmt.operand;
    print val;
    */
    if (val and val >= 0 and val <= 255) {
      if (stmt.mode == AddressingMode.ABSOLUTE and this.supportsMode(stmt.name, AddressingMode.ZERO_PAGE)) {
        stmt.mode = AddressingMode.ZERO_PAGE;
        return 2;
      }

      if (stmt.mode == AddressingMode.ABSOLUTE_X and this.supportsMode(stmt.name, AddressingMode.ZERO_PAGE_X)) {
        stmt.mode = AddressingMode.ZERO_PAGE_X;
        return 2;
      }
      if (stmt.mode == AddressingMode.ABSOLUTE_Y and this.supportsMode(stmt.name, AddressingMode.ZERO_PAGE_Y)) {
        stmt.mode = AddressingMode.ZERO_PAGE_Y;
        return 2;
      }
    }

    var mode = stmt.mode;

    if (mode == AddressingMode.IMPLIED or mode == AddressingMode.ACCUMULATOR) {
      return 1;
    }
    if (mode == AddressingMode.IMMEDIATE or
        mode == AddressingMode.ZERO_PAGE or
        mode == AddressingMode.ZERO_PAGE_X or
        mode == AddressingMode.ZERO_PAGE_Y or
        mode == AddressingMode.IND_X or
        mode == AddressingMode.IND_Y or
        mode == AddressingMode.RELATIVE) {
      return 2;
    }
    if (mode == AddressingMode.ABSOLUTE or
        mode == AddressingMode.ABSOLUTE_X or
        mode == AddressingMode.ABSOLUTE_Y or
        mode == AddressingMode.INDIRECT) {
      return 3;
    }
    return 1;
  }

  supportsMode(mnemonic, mode) {
    if (!this.opcodes.has(mnemonic)) return false;
    return this.opcodes[mnemonic].has(mode);
  }

  parseOperandValue(operand) {
    if (operand == nil) return nil;
    if (isnumber(operand)) return operand;
    if (!isstring(operand)) return nil;

    var str = operand;
    if (this.symbolTable.has(str)) {
      var symVal = this.symbolTable[str];
      if (isnumber(symVal)) return symVal;
    }

    if (str.length() == 0) return nil;

    // hex
    if (str[0] == '$') {
      return Math.from_hex(str.slice(1));
    }

    // 3 binary
    if (str[0] == '%') {
      return Math.from_bin(str.slice(1));
    }

    // 4 low/high byte extractors < >
    if (str[0] == '<' or str[0] == '>') {
      var innerVal = this.parseOperandValue(str.slice(1));
      if (innerVal != nil) {
        return (str[0] == '<') ? (innerVal % 256) : (innterVal / 256).floor();
      }
    }

    // 5 plain decimal string
    var isDec = true;
    for (var i = 0; i < str.length(); i += 1) {
      if (str[i] < '0' or str[i] > '9') {
        isDec = false;
        break;
      }
    }
    if (isDec) {
      return Number(str);
    }

    return nil;
  }

  calculateDirectiveSize(stmt) {
    var evaluator = ExpressionEvaluator();
    var name = stmt.name.to_upper();

    if (name == ".BYTE") {
      if (typeof(stmt.operand) == "Array") return stmt.operand.length();
      return 1;
    }
    if (name == ".WORD") {
      if (typeof(stmt.operand) == "Array") return stmt.operand.length() * 2;
      return 2;
    }
    if (name == ".TEXT" or stmt.name.to_upper() == ".STRING") {
      return stmt.operand.length();
    }
    if (name == ".ALIGN") {
      var boundary = evaluator.evaluate(stmt.operand, this.symbolTable, this.currentPC);
      if (boundary <= 0) boundary = 1;
      var remainder = currentPC % boundary;
      return (remainder == 0) ? 0 : (boundary - remainder);
    }
    if (name == ".FILL") {
      return evaluator.evaluate(stmt.operand, this.symbolTable, currentPC);
      return count;
    }

    if (name == ".INCBIN" or name == ".INCLUDEBIN") {
      var fileContent = File.load(stmt.operand);
      if (fileContent == nil) {
        print "Error on line " + stmt.line + ": Cannot open binary file '" + stmt.operand + "'";
        return 0;
      }

      var fileLen = fileContent.length();
      var offset = 0;

      if (stmt.offsetExpr and stmt.offsetExpr != "") {
        offset = evaluator.evaluate(stmt.offsetExpr, this.symbolTable, this.currentPC);
      }

      var count = fileLen - offset;
      if (stmt.lengthExpr and stmt.lengthExpr != "") {
        count = evaluator.evaluate(stmt.lengthExpr, this.symbolTable, this.currentPC);
      }

      if (offset >= fileLen or count <= 0) {
        stmt.binaryData = [];
        return 0;
      }

      // clamp valid read range within file bounds
      var endPos = offset + count;
      if (endPos > fileLen) endPos = fileLen;
      var slicedStr = fileContent.slice(offset, endPos);

      var bytes = slicedStr.split("").map(fun(w) { return w[0]; });

      // pad
      var padCount = count - bytes.length();
      if (padCount > 0) {
        bytes = bytes + [0; padCount];
      }
        
      stmt.binaryData = bytes;
      return bytes.length();
    }

    return 0;
  }
}
