require("d64_writer.lox");

var path = "/tmp/slox_c64_test_d64writer.d64";
var d64 = D64Writer(path, "TEST DISK", "2A");

d64.addPrgFile("MAIN", [0x78, 0xad, 0x12, 0xd0, 0x60], 2049);
d64.addSeqFile("LEVEL1.DAT", [0x01, 0x02, 0x03, 0x04]);

for (var i = 1; i <= 9; i += 1) {
  d64.addSeqFile("EXTRA" + i, [i]);
}

print !!d64.save(path); // expect: true

var image = File.load(path);
var bamOffset = 357 * 256;
print image.length(); // expect: 174848

// header padding after the DOS type
print image[bamOffset + 167]; // expect: 160
print image[bamOffset + 168]; // expect: 160
print image[bamOffset + 169]; // expect: 160
print image[bamOffset + 170]; // expect: 160

// unused BAM bits are allocated, not free
print image[bamOffset + 11]; // expect: 31
print image[bamOffset + 72 + 3]; // expect: 7
print image[bamOffset + 72]; // expect: 16

// directory chain follows interleave 3: 18/1 -> 18/4
print image[358 * 256]; // expect: 18
print image[358 * 256 + 1]; // expect: 4
