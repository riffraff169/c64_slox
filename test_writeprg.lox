require("scanner.lox");
require("c64_parser.lox");
require("opcodes.lox");
require("pass1.lox");
require("pass2.lox");
require("prg_writer.lox");

var path = "/tmp/slox_c64_test_writeprg.prg";
var source = "* = $0801\n" +
             "  LDA #$00\n" +
             "  STA $d020\n" +
             "  RTS\n";

var tokens = AssemblyScanner(source).scanTokens();
var statements = AssemblyParser(tokens).parse();
var pass1Result = Pass1(statements, OPCODES).run();
var pass2Result = Pass2(
    pass1Result["statements"],
    pass1Result["symbolTable"],
    OPCODES,
    pass1Result["startAddress"]
).run(nil);

var writer = PRGWriter(path);
print !!writer.save(pass2Result["bytes"], pass1Result["startAddress"]); // expect: true

var saved = File.load(path);
print saved.length(); // expect: 8

var hexString = "";
for (var i = 0; i < saved.length(); i += 1) {
  if (i > 0) hexString = hexString + " ";
  hexString = hexString + Math.hex(saved[i], 2, false).to_upper();
}
print hexString; // expect: 01 08 A9 00 8D 20 D0 60
