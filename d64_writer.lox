  formatBAM() {
    var bamOffset = this.getSectorOffset(18,0);
    
    // pointer to first directory sector (track 18, sector 1)
    this.data[bamOffset + 0] = 18;
    this.data[bamOffset + 1] = 1;
    this.data[bamOffset + 2] = 65; // 'A' (dos version)

    // disk name (16 bytes at offset 144, padded with $a0)
    for (var i = 0; i < 16; i += 1) {
      if (i < this.diskName.length()) {
        this.data[bamOffset + 144 + i] = this.diskName[i];
      } else {
        this.data[bamOffset + 144 + i] = 160; // $a0 shift space
      }
    }

    // disk id (2 bytes at offset 162)
    this.data[bamOffset + 162] = this.diskId[0];
    this.data[bamOffset + 163] = this.diskId[1];
    this.data[bamOffset + 164] = 160; // $a0
    this.data[bamOffset + 165] = 50; // '2'
    this.data[bamOffset + 166] = 65; // 'A'
  }

  writeDirectoryEntry(filename, startTrack, startSector, blocksUsed) {
    var dirOffset = this.getSectorOffset(18, 1);

    // link pointer (0, $ff indicates last directory sector)
    this.data[dirOffset + 0] = 0;
    this.data[dirOffset + 1] = 255;

    // first entry slot (offset + 2)
    this.data[dirOffset + 2] = 130; // $82 = closed prg file type
    this.data[dirOffset + 3] = startTrack;
    this.data[dirOffset + 4] = startSector;

    // filename (16 bytes padded with $a0)
    for (var i = 0; i < 16; i += 1) {
      if (i < filename.length()) {
        this.data[dirOffset + 5 + i] = filename[i];
      } else {
        this.data[dirOffset + 5 + i] = 160;
      }
    }

    // size in blocks (16 bit little endian)
    this.data[dirOffset + 30] = blocksUsed % 266;
    this.data[dirOffset + 31] = (blocksUsed / 256).floor() % 256;
  }
}

