require("mode.lox");

class AssemblyParser {
  const branchOpcodes = ["BNE", "BEQ", "BCC", "BCS", "BPL", "BMI", "BVC", "BVS"];

  init(tokens, visitedFiles = nil, logger = nil) {
    this.tokens = tokens;
    this.logger = logger;
    this.current = 0;
    this.visitedFiles = visitedFiles ?? [];
  }

  isBranch(mnemonic) {
    for (var i = 0; i < this.branchOpcodes.length(); i += 1) {
      if (this.branchOpcodes[i] == mnemonic.to_upper()) return true;
    }

    return false;
  }

  parse() {
    var statements = [];

    while (!this.isAtEnd()) {
      if (this.match(TokenType.NEWLINE)) {
        continue;
      }

      var stmt = this.parseLine();
      if (stmt) {
        if (typeof(stmt) == "Array") {
          statements = statements + stmt;
        } else {
          statements.push(stmt);
        }
      }
    }
    return statements;
  }

  parseLine() {
    // 1. isolate tokens belonging to the current line
    var lineTokens = [];
    while (!this.isAtEnd() and this.peek().type != TokenType.NEWLINE) {
      lineTokens.push(this.advance());
    }

    // consume trailing newline if present
    if (this.peek().type == TokenType.NEWLINE) {
      this.advance();
    }

    if (lineTokens.length() == 0) return nil;

    var idx = 0;
    var lineNum = lineTokens[0].line;
    var label = nil;

    // 2a. check for origin setting (* = $0801)
    if (lineTokens.length() >= 3 and
        lineTokens[0].type == TokenType.STAR and
        lineTokens[1].type == TokenType.EQUAL) {
      var target = lineTokens[2].literal ?? lineTokens[2].lexeme;
      this.logger?.debug("Parsed ORIGIN");
      return Statement("ORIGIN", nil, "*=", AddressingMode.IMMEDIATE, target, lineNum);
    }

    // 2b. check for constant assignment: RASTER = $d012 or RASTER EQU $d012
    if (lineTokens.length() >= 3) {
      var opLexeme = lineTokens[1].lexeme.to_upper();

      if (opLexeme == "=" or opLexeme == "EQU" or opLexeme == ".EQU") {
        var symName = lineTokens[0].lexeme;
        // strip option trailing ':'
        if (symName[symName.length() -  1] == ':') {
          symName = symName.slice(0, -1);
        }

        var valExpr = this.tokensToString(lineTokens, 2, lineTokens.length());
        this.logger?.debug("Parsed CONSTANT: " + valExpr);
        return Statement("CONSTANT", symName, opLexeme, nil, valExpr, lineNum);
      }
    }

    // 3. check for label prefix (identifier followed by colon)
    if (lineTokens.length() >= 2 and
        lineTokens[0].type == TokenType.IDENTIFIER and
        lineTokens[1].type == TokenType.COLON) {
      label = lineTokens[0].lexeme;
      idx = 2;
    }

    // if line only contains a label
    if (idx >= lineTokens.length()) {
      this.logger?.debug("Parsed LABEL: " + label);
      return Statement("LABEL_ONLY", label, "", nil, nil, lineNum);
    }

    if (lineTokens[idx].type == TokenType.DIRECTIVE) {
      //this.logger?.debug("Parsed DIRECTIVE: " + label);
      return this.parseDirective(lineTokens, idx, label, lineNum);
    }

    // 4. extract mnemonic / directive
    var nameToken = lineTokens[idx];
    var name = nameToken.lexeme.to_upper();
    idx += 1;

    var stmtType = "INSTRUCTION";
    if (nameToken.type == TokenType.DIRECTIVE or name[0] == '.') {
      stmtType = "DIRECTIVE";
    }

    // 5. parse operand & disambiguate addressing mode
    var rem = lineTokens.length() - idx;
    var lastIdx = lineTokens.length() - 1;

    // implied mode (RTS, NOP)
    if (rem == 0) {
      return Statement(stmtType, label, name, AddressingMode.IMPLIED, nil, lineNum);
    }

    // accumulator mode (ASL A)
    if (rem == 1 and lineTokens[idx].type == TokenType.IDENTIFIER and
        (lineTokens[idx].lexeme == "A" or lineTokens[idx].lexeme == "a")) {
      return Statement(stmtType, label, name, AddressingMode.ACCUMULATOR, "A", lineNum);
    }

    // immediate mode: #$00, #BORDER_COLOR + 1, #>LABEL
    if (lineTokens[idx].type == TokenType.HASH) {
      var expr = this.tokensToString(lineTokens, idx + 1, lineTokens.length());
      return Statement(stmtType, label, name, AddressingMode.IMMEDIATE, expr, lineNum);
    }

    // indirectmodes: starts with '('
    if (lineTokens[idx].type == TokenType.LPAREN) {
      //var innerVal = lineTokens[idx + 1].literal ?? lineTokens[idx + 1].lexeme;

      // check for indexed indirect ($02,x) -> ends with comma, x, rparen
      if (rem >= 5 and
          lineTokens[lastIdx - 2].type == TokenType.COMMA and
          (lineTokens[lastIdx - 1].lexeme == "X" or lineTokens[lastIdx - 1].lexeme == "x") and
          lineTokens[lastIdx].type == TokenType.RPAREN) {
        var expr = this.tokensToString(lineTokens, idx + 1, lastIdx - 2);
        return Statement(stmtType, label, name, AddressingMode.IND_X, expr, lineNum);
      }

      // check for indirect indexed ($02),y -> ends with rparent, comma, y
      if (rem >= 5 and lineTokens[idx + 2].type  == TokenType.RPAREN and
          lineTokens[idx + 3].type == TokenType.COMMA and
          (lineTokens[idx + 4].lexeme == "Y" or lineTokens[idx + 4].lexeme == "y")) {
        var expr = this.tokensToString(lineTokens, idx + 1, lastIdx - 2);
        return Statement(stmtType, label, name, AddressingMode.IND_Y, expr, lineNum);
        //return Statement(stmtType, label, name, AddressingMode.IND_Y, innerVal, lineNum);
      }

      // plain indirect jump ($a000) - ends with rparen
      if (lineTokens[lastIdx].type == TokenType.RPAREN) {
        var expr = this.tokensToString(lineTokens, idx + 1, lastIdx);
        return Statement(stmtType, label, name, AddressingMode.INDIRECT, expr, lineNum);
      }
    }

    // absolute / indexed modes($d020, $d020,x, $d020,y)
    // indexed absolute / zero page: ends with ,x or ,y
    //var target = lineTokens[idx].literal ?? lineTokens[idx].lexeme;

    if (rem >= 3 and lineTokens[lastIdx - 1].type == TokenType.COMMA) {
      var reg = lineTokens[lastIdx].lexeme.to_upper();
      var expr = this.tokensToString(lineTokens, idx, lastIdx - 1);

      if (reg == "X") {
        return Statement(stmtType, label, name, AddressingMode.ABSOLUTE_X, expr, lineNum);
      } else if (reg == "Y") {
        return Statement(stmtType, label, name, AddressingMode.ABSOLUTE_Y, expr, lineNum);
      }
    }

    var targetExpr = this.tokensToString(lineTokens, idx, lineTokens.length());
    var mode = (this.isBranch(name)) ? AddressingMode.RELATIVE : AddressingMode.ABSOLUTE;

    return Statement(stmtType, label, name, mode, targetExpr, lineNum);
  }

  tokensToString(tokens, start, end) {
    var str = "";
    for (var i = start; i < end; i += 1) {
      if (i > start)
        str = str + " ";
      str = str + tokens[i].lexeme;
    }
    return str;
  }

  parseDirectiveArgs(tokens, startIdx) {
    var raw = "";
    for (var i = startIdx; i < tokens.length(); i += 1) {
      raw = raw + tokens[i].lexeme;
    }
    return raw.trim();
  }

  parseDirective(lineTokens, startIdx, label, lineNum) {
    var dirToken = lineTokens[startIdx];
    var dirName = dirToken.lexeme.to_upper();
    var idx = startIdx + 1;

    if (dirName == ".BASIC") {
      // 12 byte SYS 2061 ($080d) BASIC header
      var basicBytes = [0x0b, 0x08, 0x0a, 0x00, 0x9e, 0x20, 0x32, 0x30, 0x36, 0x32, 0x00, 0x00, 0x00];
      this.logger?.debug("Parsed Directive: .basic");
      return Statement("DIRECTIVE", label, dirName, nil, basicBytes, lineNum);
    }
    
    if (dirName == ".BYTE") {
      var byteValues = [];
      while (idx < lineTokens.length()) {
        var t = lineTokens[idx];
        if (isnumber(t.literal)) {
          byteValues.push(t.literal ?? t.lexeme);
        }
        idx += 1;
      }
      this.logger?.debug("Parsed Directive: .byte");
      return Statement("DIRECTIVE", label, dirName, nil, byteValues, lineNum);
    }

    if (dirName == ".WORD") {
      var wordValues = [];
      while (idx < lineTokens.length()) {
        var t = lineTokens[idx];
        if (isnumber(t.literal)) {
          wordValues.push(t.literal ?? t.lexeme);
        }
        idx += 1;
      }
      this.logger?.debug("Parsed Directive: .word");
      return Statement("DIRECTIVE", label, dirName, nil, wordValues, lineNum);
    }

    if (dirName == ".INCLUDE") {
      if (idx >= lineTokens.length()) {
        print "Error: Missing filename for .include directive on line " + lineNum;
        System.exit(1);
      }

      var pathToken = lineTokens[idx];
      var path = pathToken.lexeme;
      for (var i = idx + 1; i < lineTokens.length(); i += 1) {
        path = path + lineTokens[i].lexeme;
      }

      if (path[0] == '"') {
        path = path.slice(1, -1);
      }
      this.logger?.debug("Parsed Directive: .include " + path);
      return this.processInclude(path, lineNum);
    }

    if (dirName == ".ALIGN") {
      // .align $0800 or .align 64
      var argStr = this.parseDirectiveArgs(lineTokens, idx);
      return Statement("DIRECTIVE", label, dirName, nil, argStr, lineNum);
    }

    if (dirName == ".FILL") {
      // .fill 64, $ff or .fill 64 (defaults fill byte to $00)
      var argStr = this.parseDirectiveArgs(lineTokens, idx);
      var countExpr = argStr;
      var fillExpr = "$00";

      var commaIdx = argStr.find(",");
      if (commaIdx) {
        countExpr = argStr.slice(0, commaIdx).trim();
        fillExpr = argStr.slice(commaIdx + 1).trim();
      }

      var stmt = Statement("DIRECTIVE", label, dirName, nil, countExpr, lineNum);
      stmt.fillValExpr = fillExpr;
      return stmt;
    }

    if (dirName == ".INCBIN" or dirName == ".INCLUDEBIN") {
      var argStr = this.parseDirectiveArgs(lineTokens, idx);
      var filename = argStr;
      var offsetExpr = nil;
      var lengthExpr = nil;

      var comma1 = argStr.find(",");
      if (comma1) {
        filename = argStr.slice(0, comma1).trim();
        var rest = argStr.slice(comma1 + 1).trim();
        var comma2 = rest.find(",");
        if (comma2) {
          offsetExpr = rest.slice(0, comma2).trim();
          lengthExpr = rest.slice(comma2 + 1).trim();
        } else {
          offsetExpr = rest;
        }
      }

      if (filename.length() >= 2 and filename[0] == "\"" and filename[filename.length() - 1] == "\"") {
        filename = filename.slice(1, filename.length() -1);
      }

      var stmt = Statement("DIRECTIVE", label, dirName, nil, filename, lineNum);
      stmt.offsetExpr = offsetExpr;
      stmt.lengthExpr = lengthExpr;
      return stmt;
    }

    return nil;
  }

  parseOperandTokens(tokens, startIdx) {
    var rawExpr = "";
    var reg = nil;
    var idx = startIdx;

    while (idx < tokens.length()) {
      var t = tokens[idx];

      // stop at comma for indexed addressing (LABEL + 2, X)
      if (t.type == TokenType.COMMA) {
        if (idx + 1 < tokens.length()) {
          reg = tokens[idx + 1].lexeme.to_upper();
        }
        break;
      }
      rawExpr = rawExpr + t.lexeme;
      idx += 1;
    }
    return { "expression": rawExpr, "register": reg };
  }

  processInclude(path, lineNum) {
    for (var i = 0; i < this.visitedFiles.length(); i += 1) {
      if (this.visitedFiles[i] == path) {
        print "Error: Circular .include detected for '" + path + "' on line " + lineNum;
        System.exit(1);
      }
    }

    var includeSource = File.load(path);
    if (includeSource == nil) {
      print "Error: Could not read included file '" + path + "' on line " + lineNum;
      System.exit(1);
    }

    this.visitedFiles.push(path);

    var scanner = AssemblyScanner(includeSource);
    var tokens = scanner.scanTokens();
    var subParser = AssemblyParser(tokens, this.visitedFiles);

    return subParser.parse();
  }

  peek() {
    return this.tokens[this.current];
  }

  advance() {
    var t = this.tokens[this.current];
    this.current += 1;
    return t;
  }

  match(type) {
    if (this.isAtEnd()) return false;
    if (this.peek().type == type) {
      this.advance();
      return true;
    }
    return false;
  }

  isAtEnd() {
    return this.peek().type == TokenType.EOF_TOKEN;
  }
}

