require("scanner.lox");

var source = "* = $0801\n" +
             "start:\n" +
             "  LDA #$00\n" +
             "  .text \"HI\"\n";

var tokens = AssemblyScanner(source).scanTokens();
var out = "";

for (var i = 0; i < tokens.length(); i += 1) {
  var token = tokens[i];
  if (token.type == TokenType.NEWLINE or token.type == TokenType.EOF_TOKEN) continue;
  if (out.length() > 0) out = out + " ";
  out = out + token.type + ":" + token.lexeme;
}

print out; // expect: STAR:* EQUAL:= NUMBER:$0801 IDENTIFIER:start COLON:: IDENTIFIER:LDA HASH:# NUMBER:$00 DIRECTIVE:.text STRING:"HI"
