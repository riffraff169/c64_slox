class ExpressionEvaluator {
  findLast(text, needle) {
    var last = -1;
    for (var i = 0; i + needle.length() <= text.length(); i += 1) {
      if (text.slice(i, i + needle.length()) == needle) last = i;
    }
    return last;
  }

  evaluate(exprStr, symbolTable, currentPC) {
    if (exprStr == nil or exprStr == "") return 0;

    if (isnumber(exprStr))
      return exprStr;

    var trimmed = exprStr.trim();
    if (trimmed == "") return 0;

    // high byte selector (>LABEL)
    if (trimmed[0] == '>') {
      var subVal = this.evaluate(trimmed.slice(1), symbolTable, currentPC);
      return (subVal / 256).floor() % 256;
    }

    // low byte (<label)
    if (trimmed[0] == '<') {
      var subVal = this.evaluate(trimmed.slice(1), symbolTable, currentPC);
      return subVal % 256;
    }

    // simple addition / subtraction / multiplication
    var plus = trimmed.find("+");
    if (plus >= 0) {
      return this.evaluate(trimmed.slice(0, plus), symbolTable, currentPC) +
        this.evaluate(trimmed.slice(plus + 1), symbolTable, currentPC);
    }

    // Split subtraction at the last operator so chains stay left-associative.
    var minus = this.findLast(trimmed, "-");
    if (minus >= 0) {
      return this.evaluate(trimmed.slice(0, minus), symbolTable, currentPC) -
        this.evaluate(trimmed.slice(minus + 1), symbolTable, currentPC);
    }

    // current pc symbol (*)
    if (trimmed == "*") return currentPC;

    var star = trimmed.find("*");
    if (star >= 0) {
      return this.evaluate(trimmed.slice(0, star), symbolTable, currentPC) *
        this.evaluate(trimmed.slice(star + 1), symbolTable, currentPC);
    }

    // hex literal ($d020)
    if (trimmed[0] == '$') {
      return Math.from_hex("0x" + trimmed.slice(1));
    }

    // binary literal
    if (trimmed[0] == '%') {
      return Math.from_bin(trimmed.slice(1));
    }

    if (symbolTable.has(trimmed)) {
      return symbolTable[trimmed];
    }

    // decimal
    var num = Integer(trimmed);
    if (num == 0 and trimmed.length() > 1) {
      print "Error: Undefined symbol or expression '" + trimmed + "'";
      System.exit(1);
    }
    return num;
  }
}
